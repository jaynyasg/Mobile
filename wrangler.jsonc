{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tatel",
  "compatibility_date": "2026-11-12",
  "main": "worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // MP4s need range responses. /api/* is the program proxy, sign-in, checkout, and VIP bookings.
    // Manifest and icons are served here so the SPA shell cannot replace them.
    // Secrets, not vars: wrangler secret put STRIPE_SECRET_KEY
    // wrangler secret put STRIPE_WEBHOOK_SECRET
    // wrangler secret put VIP_SIGNING_PRIVATE_KEY
    "run_worker_first": ["/api/*", "/*.mp4", "/manifest.webmanifest", "/apple-touch-icon.png", "/favicon.ico", "/icons/*"]
  },
  "triggers": {
    "crons": ["17 * * * *"]
  },
  "send_email": [
    { "name": "EMAIL" }
  ],
  "vars": {
    "SUPABASE_URL": "https://oykwxnzlpxbrfcoejawt.supabase.co",
    "STRIPE_PRICE_BEACH": "price_1UbToMRqnFhvQ1qEsP0qj1b8",
    "STRIPE_PRICE_BOAT": "price_1UbToRRqnFhvQ1qEqvHiOHHo",
    "STRIPE_PRICE_VIP": "price_1UbToURqnFhvQ1qEunY1AOnL",
    "TEAM_NOTIFY_EMAIL": "contact1878@gmail.com",
    "TEAM_NOTIFY_FROM": "passes@tatel.app"
  }
}

{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tatel",
  "compatibility_date": "2026-11-12",
  "main": "worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // MP4s need range responses. /api/program proxies the published program file.
    "run_worker_first": ["/api/*", "/*.mp4"]
  }
}

# Optional override. On https://tatel.app the app requests /api/program.
# EXPO_PUBLIC_CONTENT_URL=https://tatel.18seventy8.com/tatel/downloads/tatel-2027-program.json

# Supabase anon key is public. Defaults live in src/community/client.ts.
EXPO_PUBLIC_SUPABASE_URL=https://oykwxnzlpxbrfcoejawt.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Set to 1 only for local UI previews. Leave unset for the live community.
EXPO_PUBLIC_COMMUNITY_PREVIEW=

# Optional Stripe publishable-key override (pk_test_... for a test environment).
# TATEL's existing live publishable key is the public default in src/logic/passPay.ts.
# Never put a Stripe secret key in an EXPO_PUBLIC_ variable.
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=
